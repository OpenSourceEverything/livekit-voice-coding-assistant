LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional local settings (defaults shown; uncomment only what you need):
# REPO_ROOT=var/demo-repo
# ENABLE_LOCAL_TESTS=false
# ENABLE_PROPOSALS=true
# Opt-in: authenticated phone callers may stage a diff only; separate local approval/apply remains required.
# ENABLE_PHONE_PROPOSALS=false
# ENABLE_CODEX=false
# Opt-in durable requests, processed by a SEPARATE local proposal-only worker.
# ENABLE_BACKGROUND_JOBS=false
# ENABLE_JOB_CODEX=false
# JOBS_DATABASE=var/jobs.sqlite3
# PHONE_ACCESS_PIN=
# AGENT_NAME=coding-buddy-local
# USAGE_PATH=var/usage.jsonl
# LIVEKIT_PROJECT_ID=
# Allowlisted RTC/SIP lifecycle events; no raw transcripts, PINs or signaling packets.
# CALL_LOG_PATH=var/calls.jsonl
# EXPLICIT_STOP=true
# Keep the baseline unless deliberately comparing one setting on a real call.
# INTERRUPTION_MIN_DURATION=0.5
# Local VAD is the default; true opts into quota-limited cloud classification.
# ADAPTIVE_INTERRUPTION=false
